<Window x:Class="AudioCaptureApp.WhisperModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Whisper モデルの管理"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        REQ-MODELWIN-01〜06: 登録済み Whisper モデル（エイリアス＋パス）の追加・名前変更・削除。
        自前の状態を持たず、MainViewModel を DataContext として共有する（ADR-0002 / ADR-0006）。
        編集中の入力と検証エラーも MainViewModel が持つ。変更はその場で保存されるため「閉じる」だけを置く。
    -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 一覧 ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="登録済みのモデル" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
                <ListBox Height="150"
                         ItemsSource="{Binding WhisperModels}"
                         SelectedItem="{Binding ManagedWhisperModel}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ModelName}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ModelPath}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelPath}"
                                           Style="{StaticResource Text.Caption}" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- REQ-MODELWIN-08: 並び替え（ドロップダウンの順序になる） -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="上へ" MinWidth="64" Margin="0,0,8,0"
                                Command="{Binding MoveWhisperModelUpCommand}"/>
                        <Button Content="下へ" MinWidth="64"
                                Command="{Binding MoveWhisperModelDownCommand}"/>
                    </StackPanel>
                    <!-- REQ-MODELWIN-04: 選択中のモデルなら選択を解除して「モデル未設定」へ -->
                    <Button Grid.Column="1" Content="削除" MinWidth="90"
                            Command="{Binding RemoveWhisperModelCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== 追加 / 名前の変更（REQ-MODELWIN-02 / 03）。選択中は「名前の変更」、未選択は「追加」のどちらか一方 ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="追加">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingWhisperModel}" Value="True">
                                        <Setter Property="Text" Value="選択中のモデルの名前を変更"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 選択を外して追加モードへ戻す -->
                    <Button Grid.Column="1" Content="新しく追加" Command="{Binding NewWhisperModelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Small}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingWhisperModel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名前" Style="{StaticResource Text.Label}"/>
                    <TextBox Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding EditingModelName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ファイル" Style="{StaticResource Text.Label}"/>
                    <TextBox Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"
                             Text="{Binding EditingModelPath, Mode=OneWay}"
                             ToolTip="{Binding EditingModelPath}"/>
                    <Button Grid.Column="2" Content="参照…"
                            Command="{Binding BrowseWhisperModelFileCommand}"/>
                </Grid>

                <!-- 検証に通らなかった理由（REQ-MODELWIN-02）。空なら畳む -->
                <TextBlock Text="{Binding WhisperModelError}" Margin="0,0,0,8" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Error}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WhisperModelError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="登録時にはファイルがあることだけを確認します。モデルとして読み込めるかどうかは、実際に選んだときに分かります。"
                           Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <!-- 主ボタン 1 つがモードで切り替わる。選択中に「追加」を押せる状態を作らない（T172） -->
                <Grid HorizontalAlignment="Right">
                    <Button Content="追加" MinWidth="110" Command="{Binding AddWhisperModelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Accent}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingWhisperModel}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="名前を変更" MinWidth="110" Command="{Binding RenameWhisperModelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Accent}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingWhisperModel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- REQ-MODELWIN-06: 変更はその場で保存済み。取り消しは無いので「閉じる」だけ -->
        <Button Grid.Row="2" Content="閉じる" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="90"/>
    </Grid>
</Window>
