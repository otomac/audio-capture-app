<Window x:Class="AudioCaptureApp.FileTranscriptionOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ファイルから文字起こし"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFE0E0E0">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,2"/>
        </Style>

        <!-- 処理前だけ見せるボタン（開始 / キャンセル） -->
        <Style x:Key="IdleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTranscribingFile}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 処理中だけ見せるボタン（中止） -->
        <Style x:Key="BusyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTranscribingFile}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 処理中だけ見せる進捗ブロック -->
        <Style x:Key="BusyPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTranscribingFile}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Row 0: 対象ファイル -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="ファイル" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="：" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FileTranscriptionFileName}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip="{Binding FileTranscriptionFileName}" Margin="0,0,0,12"/>

        <!-- Row 1: 開始時刻 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="開始時刻" VerticalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="：" VerticalAlignment="Center" Margin="0,0,8,4"/>
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBox Width="70" VerticalContentAlignment="Center"
                     Text="{Binding FileTranscriptionStartTime, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTranscribingFile}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="hh:mm（空欄ならファイル先頭を 00:00:00 とする）"
                       VerticalAlignment="Center" Foreground="#FF555555" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Row 2: 書式エラー -->
        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,0,12"
                   Text="24 時間表記の hh:mm で入力してください（例: 9:05 / 14:30）"
                   Foreground="#FFCC0000">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFileTranscriptionStartTimeError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Row 3: 言語 (REQ-TRX-FILE-16)。ライブ側の選択とは独立 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="言語" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="：" VerticalAlignment="Center" Margin="0,0,8,12"/>
        <ComboBox Grid.Row="3" Grid.Column="2"
                  ItemsSource="{Binding FileLanguageOptions}"
                  SelectedItem="{Binding SelectedFileLanguage}"
                  DisplayMemberPath="DisplayName"
                  HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,12">
            <ComboBox.Style>
                <Style TargetType="ComboBox">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTranscribingFile}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>

        <!-- Row 4: 進捗（処理中のみ） -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource BusyPanel}" Margin="0,0,0,12">
            <ProgressBar Height="14" Minimum="0" Maximum="100"
                         Value="{Binding FileTranscriptionProgress, Mode=OneWay}"/>
            <TextBlock Text="{Binding FileTranscriptionStatus}"
                       Foreground="#FF555555" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Row 5: ボタン -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="開始" Style="{StaticResource IdleButton}"
                    IsEnabled="{Binding CanStartFileTranscription}"
                    IsDefault="True" Click="StartButton_Click" Margin="0,0,8,0"/>
            <Button Content="キャンセル" Style="{StaticResource IdleButton}" IsCancel="True"/>
            <Button Content="中止" Style="{StaticResource BusyButton}"
                    Command="{Binding CancelFileTranscriptionCommand}"
                    Background="#FFCC0000" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>