<Window x:Class="AudioCaptureApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioCaptureApp"
        xmlns:controls="clr-namespace:AudioCaptureApp.Controls"
        mc:Ignorable="d"
        Title="音声キャプチャ"
        Width="480" Height="374"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="Window_DragOver"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <!--
        T154: メインウィンドウは「録音するための操作面」に絞る（REQ-SETWIN-01）。
        常時表示しなくてよい設定は SettingsWindow へ置き、ステータスバーの「設定…」から開く。
        ドロップの受け口はウィンドウ全体である（REQ-TRX-FILE-02）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="14">

            <!-- ===== 入力 ＋ 録音 =====
                 「入力デバイス」と「音声ミキサー」を 1 枚にまとめる。
                 1 デバイス＝1 行で、レベルメーターはコンボの直下に敷く（REQ-LVL-07）。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>

                    <!-- マイク -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="マイク" Width="56"
                                   Style="{StaticResource Text.Label}"/>
                        <!-- デバイス名が長くても幅は変わらず、はみ出しは省略される（NFR-09） -->
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding CaptureDevices}"
                                  SelectedItem="{Binding SelectedCaptureDevice}"
                                  IsEnabled="{Binding IsNotBusy}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ToggleButton Grid.Row="0" Grid.Column="2" Margin="8,0,0,0"
                                      Style="{StaticResource ToggleButton.Mute}"
                                      IsChecked="{Binding IsMicMuted}"/>
                        <controls:LevelMeterControl Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                                    Level="{Binding MicLevelDb}"/>
                    </Grid>

                    <!-- スピーカー -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="スピーカー" Width="56"
                                   Style="{StaticResource Text.Label}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding RenderDevices}"
                                  SelectedItem="{Binding SelectedRenderDevice}"
                                  IsEnabled="{Binding IsNotBusy}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ToggleButton Grid.Row="0" Grid.Column="2" Margin="8,0,0,0"
                                      Style="{StaticResource ToggleButton.Mute}"
                                      IsChecked="{Binding IsSpeakerMuted}"/>
                        <controls:LevelMeterControl Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                                    Level="{Binding LoopbackLevelDb}"/>
                    </Grid>

                    <Border Style="{StaticResource Card.Divider}"/>

                    <!-- 録音。状態の文言は経過時間の上の行に置き、固定幅にする（NFR-09） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="● 録音開始"
                                Style="{StaticResource Button.Record}"
                                Command="{Binding StartRecordingCommand}"/>
                        <Button Grid.Column="1" Content="■ 停止" Margin="8,0,0,0"
                                Style="{StaticResource Button.Stop}"
                                Command="{Binding StopRecordingCommand}"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecordingStatusText}"
                                       Foreground="{Binding RecordingStatusColor}"
                                       Style="{StaticResource Text.Label}"
                                       Width="{StaticResource Size.RecordingStatusWidth}"
                                       TextAlignment="Right"/>
                            <TextBlock Text="{Binding ElapsedTime}"
                                       Foreground="{Binding RecordingStatusColor}"
                                       Style="{StaticResource Text.Clock}"
                                       TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 文字起こし ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="録音中にライブ文字起こしする"
                                  IsChecked="{Binding TranscriptionEnabled}"
                                  IsEnabled="{Binding IsNotBusy}"/>
                        <!-- REQ-LIVEVIEW-01: 見るための窓なので、録音中・処理中でも押せる -->
                        <Button Grid.Column="1" Content="表示"
                                Style="{StaticResource Button.Small}"
                                Command="{Binding ShowLiveTranscriptCommand}"/>
                    </Grid>

                    <!--
                        REQ-TRX-FILE-01 / 02: クリック＝ファイル選択、ドロップ＝即開始の 1 部品。
                        破線枠は入口を示す表示であって、受け口自体はウィンドウ全体である。
                    -->
                    <Button Style="{StaticResource Button.DropTarget}"
                            Command="{Binding TranscribeFromFileCommand}">
                        <StackPanel>
                            <TextBlock Text="音声ファイルから文字起こし"
                                       Foreground="{StaticResource Brush.Accent}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="クリックして選択 — .wav / .mp3 はウィンドウのどこへ落としても開始"
                                       Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== ステータスバー ===== -->
        <Border Grid.Row="1" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Label}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- REQ-TRX-DIA-15: 話者識別の状態はここ 1 か所に出す。幅は固定（NFR-09） -->
                <Border Grid.Column="1" Margin="8,0,0,0"
                        Style="{StaticResource Pill}"
                        ToolTip="{Binding SpeakerDiarizationTooltip}">
                    <TextBlock Text="{Binding SpeakerDiarizationStatus}"
                               Style="{StaticResource Text.Label}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- REQ-SETWIN-02 / 05: モーダルで開く。録音中・処理中は無効 -->
                <Button Grid.Column="2" Content="設定…" Margin="8,0,0,0"
                        Style="{StaticResource Button.Small}"
                        Command="{Binding ShowSettingsCommand}"/>
                <Button Grid.Column="3" Content="保存先を開く" Margin="6,0,0,0"
                        Style="{StaticResource Button.Small}"
                        Command="{Binding OpenResultFolderCommand}"/>
            </Grid>
        </Border>

        <!-- ドラッグ＆ドロップ用オーバーレイ（REQ-TRX-FILE-04）。
             重ね置きなので、表示・非表示で下の部品は動かない（NFR-09）。 -->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource Brush.DropOverlay}"
                BorderBrush="{StaticResource Brush.DropOverlayBorder}"
                BorderThickness="2"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="ここにドロップして文字起こしを開始"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>