<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nullable / ImplicitUsings / LangVersion と静的解析の設定は
    ルートの Directory.Build.props が全プロジェクトへ適用する。ここで重複させない。
    パッケージのバージョンは Directory.Packages.props (CPM) が持つため、
    PackageReference に Version 属性を書かない。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AudioCaptureApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Lame" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Whisper.net" />
    <!--
      Whisper 実行ランタイムは複数同梱し、起動時に利用可能な最速のものを自動選択する。
      優先順: Cuda (NVIDIA) > Vulkan (Intel/AMD iGPU, その他 GPU) > CPU
    -->
    <PackageReference Include="Whisper.net.Runtime.Cuda" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <PackageReference Include="Whisper.net.Runtime" />
    <!--
      話者ダイアライゼーション（ADR-0003）。org.k2fsa.sherpa.onnx は 9 プラットフォーム分の
      ネイティブランタイムを推移的に引き込むため、win-x64 以外を直接参照 ＋ ExcludeAssets="all" で打ち消す。
      直接参照は推移参照より優先されるため、これで当該アセットが一切流れてこなくなる。
      実測: 未対策だと出力に約 330MB のネイティブが並ぶ。対策後は runtimes/win-x64 のみ（約 22MB）。
    -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" ExcludeAssets="all" />
  </ItemGroup>

  <!--
    self-contained 発行時: 同梱ランタイムから未使用の System.Net.Mail.dll を除く（T180）。
    ウイルスバスターがこれを「メールクライアント機能」とみなして起動確認を出すため。
    deps.json は RuntimePackAsset から、出力へのコピーは ResolveRuntimePackAssets が同時に積む
    ReferenceCopyLocalPaths から作られるので、両方から除く
    （ファイルだけ消すと deps.json の記載が残り起動に失敗する）。
    System.Net.Mail を使う機能を足すときは、このターゲットを外すこと。
  -->
  <Target Name="ExcludeSystemNetMailFromRuntimePack" AfterTargets="ResolveRuntimePackAssets" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'System.Net.Mail.dll'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Net.Mail.dll'" />
    </ItemGroup>
  </Target>

  <!--
    PublishSingleFile 時（T205）: Whisper.net のネイティブランタイム（runtimes\...）は exe に入れず、exe の隣に置く。
    Whisper.net はアプリのフォルダの runtimes\ からランタイムを探すため、exe に入れて一時フォルダへ展開させると
    見つけられず、モデルを読み込めない（実測）。CUDA / Vulkan の DLL は 100MB を超え、初回起動の展開も遅くなる。
    win-x64 以外（linux-x64・win-arm64・win-x86）のランタイムは使わないので発行しない。
    LAME（libmp3lame.*.dll、LGPL）も exe に入れず、今までどおり差し替えられる別ファイルのまま隣に置く。
  -->
  <Target Name="KeepNativeRuntimesBesideSingleFile" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('win-x64'))" />
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('libmp3lame'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- PublishSingleFile 時: .pdb を削除 -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Delete Files="$(PublishDir)AudioCaptureApp.pdb" />
  </Target>

</Project>
