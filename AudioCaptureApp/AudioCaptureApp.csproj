<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nullable / ImplicitUsings / LangVersion と静的解析の設定は
    ルートの Directory.Build.props が全プロジェクトへ適用する。ここで重複させない。
    パッケージのバージョンは Directory.Packages.props (CPM) が持つため、
    PackageReference に Version 属性を書かない。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AudioCaptureApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Lame" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Whisper.net" />
    <!--
      Whisper 実行ランタイムは複数同梱し、起動時に利用可能な最速のものを自動選択する。
      優先順: Cuda (NVIDIA) > Vulkan (Intel/AMD iGPU, その他 GPU) > CPU
    -->
    <PackageReference Include="Whisper.net.Runtime.Cuda" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <PackageReference Include="Whisper.net.Runtime" />
    <!--
      話者ダイアライゼーション（ADR-0003）。org.k2fsa.sherpa.onnx は 9 プラットフォーム分の
      ネイティブランタイムを推移的に引き込むため、win-x64 以外を直接参照 ＋ ExcludeAssets="all" で打ち消す。
      直接参照は推移参照より優先されるため、これで当該アセットが一切流れてこなくなる。
      実測: 未対策だと出力に約 330MB のネイティブが並ぶ。対策後は runtimes/win-x64 のみ（約 22MB）。
    -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" ExcludeAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" ExcludeAssets="all" />
  </ItemGroup>

  <!-- PublishSingleFile 時: 不要な runtimes (arm64/x86) と .pdb を削除 -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <RemoveDir Directories="$(PublishDir)runtimes\win-arm64" />
    <RemoveDir Directories="$(PublishDir)runtimes\win-x86" />
    <Delete Files="$(PublishDir)AudioCaptureApp.pdb" />
  </Target>

</Project>
