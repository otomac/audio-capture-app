<!--
    T154 — 見た目の基準値（色・角丸・書体・固定寸法）。
    ここには「値」だけを置き、コントロールの見た目は Controls.xaml が組み立てる。
    NuGet の UI ライブラリは導入していない（CLAUDE.md「ライブラリ追加は個別承認制」/ 決定 D11）。
    ダークテーマは対象外（決定 D12）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== 地と面 ===== -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FFF4F5F8"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#FFE4E6EC"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#FFEDEFF3"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="Brush.Text" Color="#FF26303F"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF6A7180"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#FFA3AAB6"/>

    <!-- ===== アクセント（録音以外の主操作） ===== -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0F6CBD"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF0C5CA3"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FFEAF2FA"/>

    <!-- ===== 録音・ミュート（「止めないと不味い」状態） ===== -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFC62828"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#FFAD2121"/>

    <!-- ===== 入力コントロール ===== -->
    <SolidColorBrush x:Key="Brush.Control" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#FFD2D6DE"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#FFF0F2F6"/>
    <SolidColorBrush x:Key="Brush.ControlBorderHover" Color="#FFB9C1CE"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#FFE5E9F0"/>
    <SolidColorBrush x:Key="Brush.ControlDisabled" Color="#FFF2F3F6"/>
    <SolidColorBrush x:Key="Brush.ControlBorderDisabled" Color="#FFE2E5EB"/>

    <!-- ===== ステータスバー ===== -->
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#FFEFF1F5"/>
    <SolidColorBrush x:Key="Brush.StatusBarBorder" Color="#FFE0E3EA"/>

    <!-- ===== ドロップ領域（REQ-TRX-FILE-01 / 02 で合体した部品） ===== -->
    <SolidColorBrush x:Key="Brush.DropBorder" Color="#FFB3BCCA"/>
    <SolidColorBrush x:Key="Brush.DropBackground" Color="#FFF7FAFD"/>
    <SolidColorBrush x:Key="Brush.DropOverlay" Color="#CC1E88E5"/>
    <SolidColorBrush x:Key="Brush.DropOverlayBorder" Color="#FF0D47A1"/>

    <!-- ===== レベルメーター =====
         REQ-LVL-07: 3 ゾーン（緑／黄／赤）の色分けは寸法を変えても保つ。
         色そのものが「クリップが近い」ことを伝えているため。 -->
    <SolidColorBrush x:Key="Brush.Meter.Green" Color="#FF22B14C"/>
    <SolidColorBrush x:Key="Brush.Meter.Yellow" Color="#FFFFC800"/>
    <SolidColorBrush x:Key="Brush.Meter.Red" Color="#FFED1C24"/>
    <SolidColorBrush x:Key="Brush.Meter.Unlit" Color="#FFE3E6EB"/>

    <!-- ===== 角丸 ===== -->
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>

    <!-- ===== 書体 =====
         サイズは 3 段に整理する（本文 12 / ラベル 11 / 経過時間 22）。
         経過時間だけ等幅にするのは、桁が揺れて時計が伸び縮みしないようにするため（NFR-09）。 -->
    <FontFamily x:Key="Font.Ui">Yu Gothic UI, Segoe UI, Meiryo UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Font.Body">12</sys:Double>
    <sys:Double x:Key="Font.Label">11</sys:Double>
    <sys:Double x:Key="Font.Clock">22</sys:Double>

    <!-- ===== 固定寸法 =====
         NFR-09: 状態で変わってよいのは色と文字だけで、寸法と位置は変えない。
         いずれも「最長の状態」に合わせた値である。 -->
    <sys:Double x:Key="Size.MuteButtonWidth">78</sys:Double>
    <sys:Double x:Key="Size.RecordingStatusWidth">72</sys:Double>
    <sys:Double x:Key="Size.DiarizationPillWidth">132</sys:Double>
    <sys:Double x:Key="Size.MeterHeight">4</sys:Double>

</ResourceDictionary>